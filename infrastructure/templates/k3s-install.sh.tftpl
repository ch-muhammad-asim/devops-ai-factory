#!/usr/bin/env bash
# K3s HA node bootstrap. Rendered by Terragrunt and delivered through EC2 user
# data so every node converges during first boot without SSH.
set -euo pipefail

exec > >(tee /var/log/k3s-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

NODE_NAME="${node_name}"
NODE_ROLE="${node_role}"
SERVER_URL="${server_url}"
K3S_TOKEN="${k3s_token}"
EXPECTED_NODE_COUNT="${expected_node_count}"

echo "[k3s-bootstrap] node: $NODE_NAME"
echo "[k3s-bootstrap] role: $NODE_ROLE"
echo "[k3s-bootstrap] target version: ${k3s_version}"
echo "[k3s-bootstrap] preparing Ubuntu host"

# Unattended upgrades commonly hold the dpkg lock on a fresh Ubuntu boot.
APT_OPTS=(-o DPkg::Lock::Timeout=600)
apt-get "$${APT_OPTS[@]}" update -y
apt-get "$${APT_OPTS[@]}" install -y --no-install-recommends ca-certificates curl snapd

for binary in curl systemctl; do
  command -v "$binary" >/dev/null 2>&1 || {
    echo "[k3s-bootstrap] $binary is required but was not found" >&2
    exit 1
  }
done

# Kubeconfig retrieval uses AWS Systems Manager instead of SSH. Canonical Ubuntu
# AWS images normally include the SSM Agent; this also handles a missing agent.
if systemctl cat amazon-ssm-agent.service >/dev/null 2>&1; then
  systemctl enable --now amazon-ssm-agent.service
elif systemctl cat snap.amazon-ssm-agent.amazon-ssm-agent.service >/dev/null 2>&1; then
  systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service
else
  echo "[k3s-bootstrap] SSM Agent not found; installing the snap package"
  snap install amazon-ssm-agent --classic
  snap start amazon-ssm-agent
fi

imds_token() {
  curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 300"
}

PUBLIC_IP=""
TOKEN=""
for attempt in $(seq 1 30); do
  TOKEN="$(imds_token || true)"
  if [ -n "$TOKEN" ]; then
    PUBLIC_IP="$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
      http://169.254.169.254/latest/meta-data/tags/instance/PublicIp || true)"

    if [ -z "$PUBLIC_IP" ]; then
      PUBLIC_IP="$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
        http://169.254.169.254/latest/meta-data/public-ipv4 || true)"
    fi
  fi

  if [ -n "$PUBLIC_IP" ]; then
    echo "[k3s-bootstrap] discovered public address $PUBLIC_IP"
    break
  fi

  echo "[k3s-bootstrap] waiting for public address metadata ($attempt/30)"
  sleep 5
done

if [ -z "$PUBLIC_IP" ] || [ -z "$TOKEN" ]; then
  echo "[k3s-bootstrap] no public address was associated with this node" >&2
  exit 1
fi

PRIVATE_IP="$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/local-ipv4)"

wait_for_server() {
  if [ -z "$SERVER_URL" ]; then
    echo "[k3s-bootstrap] SERVER_URL is required for role $NODE_ROLE" >&2
    exit 1
  fi

  for attempt in $(seq 1 120); do
    if curl -kfsS --connect-timeout 2 "$SERVER_URL/cacerts" >/dev/null 2>&1; then
      echo "[k3s-bootstrap] bootstrap server is reachable at $SERVER_URL"
      return 0
    fi

    echo "[k3s-bootstrap] waiting for bootstrap server $SERVER_URL ($attempt/120)"
    sleep 5
  done

  echo "[k3s-bootstrap] bootstrap server did not become reachable" >&2
  exit 1
}

case "$NODE_ROLE" in
  server-init)
    echo "[k3s-bootstrap] initializing first K3s server with embedded etcd"
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_VERSION="${k3s_version}" \
      sh -s - server \
        --cluster-init \
        --token "$K3S_TOKEN" \
        --node-name "$NODE_NAME" \
        --node-ip "$PRIVATE_IP" \
        --node-taint "CriticalAddonsOnly=true:NoExecute" \
        --tls-san "$PUBLIC_IP" \
        --tls-san "$PRIVATE_IP" \
        --write-kubeconfig-mode 600 ${traefik_flag}
    ;;

  server)
    wait_for_server
    echo "[k3s-bootstrap] joining K3s control-plane server to $SERVER_URL"
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_VERSION="${k3s_version}" \
      sh -s - server \
        --server "$SERVER_URL" \
        --token "$K3S_TOKEN" \
        --node-name "$NODE_NAME" \
        --node-ip "$PRIVATE_IP" \
        --node-taint "CriticalAddonsOnly=true:NoExecute" \
        --tls-san "$PUBLIC_IP" \
        --tls-san "$PRIVATE_IP" \
        --write-kubeconfig-mode 600 ${traefik_flag} || \
      echo "[k3s-bootstrap] first start failed (concurrent etcd join?); systemd will retry"
    ;;

  agent)
    wait_for_server
    echo "[k3s-bootstrap] joining K3s worker to $SERVER_URL"
    curl -sfL https://get.k3s.io | \
      INSTALL_K3S_VERSION="${k3s_version}" \
      sh -s - agent \
        --server "$SERVER_URL" \
        --token "$K3S_TOKEN" \
        --node-name "$NODE_NAME" \
        --node-ip "$PRIVATE_IP" || \
      echo "[k3s-bootstrap] first start failed; systemd will retry"
    ;;

  *)
    echo "[k3s-bootstrap] unsupported node role: $NODE_ROLE" >&2
    exit 1
    ;;
esac

SERVICE_NAME="k3s"
if [ "$NODE_ROLE" = "agent" ]; then
  SERVICE_NAME="k3s-agent"
fi

for attempt in $(seq 1 240); do
  if systemctl is-active --quiet "$SERVICE_NAME"; then
    if [ "$NODE_ROLE" != "server-init" ]; then
      echo "[k3s-bootstrap] $NODE_NAME is running"
      exit 0
    fi

    # Do not publish the operator kubeconfig until the complete lab topology has
    # registered. This keeps downstream Helm units from racing a partial cluster.
    REGISTERED_NODES="$(/usr/local/bin/k3s kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')"
    READY_NODES="$(/usr/local/bin/k3s kubectl get nodes --no-headers 2>/dev/null | awk '$2 ~ /^Ready/ { count++ } END { print count + 0 }')"
    if [ "$REGISTERED_NODES" -ge "$EXPECTED_NODE_COUNT" ] && [ "$READY_NODES" -ge "$EXPECTED_NODE_COUNT" ]; then
      /usr/local/bin/k3s --version
      /usr/local/bin/k3s kubectl get nodes -o wide

      install -d -m 0700 /etc/rancher/k3s
      sed "s#https://127.0.0.1:6443#https://$PUBLIC_IP:6443#" \
        /etc/rancher/k3s/k3s.yaml > /etc/rancher/k3s/k3s-public.yaml
      chmod 0600 /etc/rancher/k3s/k3s-public.yaml

      echo "[k3s-bootstrap] all $READY_NODES/$EXPECTED_NODE_COUNT nodes Ready; kubeconfig published"
      exit 0
    fi

    echo "[k3s-bootstrap] waiting for all nodes: registered=$REGISTERED_NODES/$EXPECTED_NODE_COUNT ready=$READY_NODES/$EXPECTED_NODE_COUNT"
  fi

  sleep 5
done

echo "[k3s-bootstrap] node did not become ready in time" >&2
systemctl status "$SERVICE_NAME" --no-pager || true
exit 1
